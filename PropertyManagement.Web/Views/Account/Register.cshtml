@model RegisterViewModel

@{
    ViewData["Title"] = "Sign Up";
}

<h2>Sign Up</h2>
<div class="row">
    <div class="col-md-6 col-lg-5">
        <form asp-controller="Account" asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control"
                       autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Role" class="form-label">Register As</label>
                <select asp-for="Role" class="form-select">
                    <option value="">-- Select Role --</option>
                    <option value="@RoleNames.Applicant">Applicant</option>
                    <option value="@RoleNames.PropertyManager">Property Manager</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Create Account</button>
            <a asp-controller="Account" asp-action="Login" class="btn btn-link">
                Already have an account? Log in
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}