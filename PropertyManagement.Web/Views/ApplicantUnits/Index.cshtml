@model ApplicantUnitSearchViewModel

@{
    ViewData["Title"] = "Browse Units";
}

<h2>Browse Units</h2>
<p class="text-muted">Explore rental units and compare their features.</p>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (!Model.Units.Any())
{
    <div class="alert alert-info">
        No units are currently listed.
    </div>
}
else
{
    <form asp-action="Index" method="get" class="row g-3 mb-4">
        <div class="col-md-5">
            <label asp-for="PropertyId" class="form-label">Property</label>
            <select asp-for="PropertyId"
                    asp-items="Model.Properties"
                    class="form-select">
                <option value="">All Properties</option>
            </select>
        </div>

        <div class="col-md-3">
            <label asp-for="MinimumBedrooms" class="form-label">
                Minimum Bedrooms
            </label>
            <input asp-for="MinimumBedrooms"
                   type="number"
                   min="0"
                   class="form-control" />
        </div>

        <div class="col-md-4 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary">
                Filter
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                Clear
            </a>
        </div>
    </form>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Property</th>
                <th>Address</th>
                <th>Unit</th>
                <th>Type</th>
                <th>Bedrooms</th>
                <th>Monthly Rent</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var unit in Model.Units)
            {
                <tr>
                    <td>@unit.PropertyName</td>
                    <td>@unit.PropertyAddress</td>
                    <td>@unit.UnitNumber</td>
                    <td>@unit.UnitTypeName</td>
                    <td>@unit.Bedrooms</td>
                    <td>@unit.MonthlyRent.ToString("C")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@unit.Id"
                           class="btn btn-sm btn-primary">
                            Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}