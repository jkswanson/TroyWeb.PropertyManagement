@model PropertyViewModel

<div class="modal-header">
    <h5 class="modal-title">Delete Property</h5>
    <button type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"></button>
</div>

<form asp-controller="Properties"
      asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">

    @Html.AntiForgeryToken()

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <p>Are you sure you want to delete this property?</p>

        <dl class="row mb-0">
            <dt class="col-sm-4">Property</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Address</dt>
            <dd class="col-sm-8">@Model.Address</dd>

            <dt class="col-sm-4">Units</dt>
            <dd class="col-sm-8">@Model.UnitCount</dd>
        </dl>

        @if (Model.UnitCount > 0)
        {
            <div class="alert alert-warning mt-3 mb-0">
                This property contains units and cannot be deleted.
                Remove its units first.
            </div>
        }
    </div>

    <div class="modal-footer">
        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit"
                class="btn btn-danger"
                disabled="@(Model.UnitCount > 0)">
            Delete Property
        </button>
    </div>
</form>