@model ResidenceHistoryViewModel

<div class="modal-header">
    <h5 class="modal-title">Delete Residence History</h5>
    <button type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"></button>
</div>

<form id="deleteResidenceForm"
      asp-controller="ResidenceHistories"
      asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">

    @Html.AntiForgeryToken()

    <div class="modal-body">
        <p>Are you sure you want to delete this residence?</p>

        <dl class="row mb-0">
            <dt class="col-sm-4">Address</dt>
            <dd class="col-sm-8">@Model.Address</dd>

            <dt class="col-sm-4">Move In</dt>
            <dd class="col-sm-8">@Model.MoveInDate?.ToString("d")</dd>

            <dt class="col-sm-4">Move Out</dt>
            <dd class="col-sm-8">@Model.MoveOutDate?.ToString("d")</dd>

            <dt class="col-sm-4">Landlord</dt>
            <dd class="col-sm-8">@Model.LandlordName</dd>

            <dt class="col-sm-4">Phone</dt>
            <dd class="col-sm-8">@Model.LandlordPhone</dd>
        </dl>
    </div>

    <div class="modal-footer">
        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit" class="btn btn-danger">
            Delete Residence
        </button>
    </div>
</form>