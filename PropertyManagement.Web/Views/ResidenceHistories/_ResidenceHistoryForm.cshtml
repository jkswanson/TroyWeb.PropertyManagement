@model ResidenceHistoryViewModel

@{
    bool isEdit = Model.Id > 0;
}

<form id="residenceForm" asp-controller="ResidenceHistories" asp-action="@(isEdit ? "Edit" : "Create")"
      asp-route-id="@(isEdit ? Model.Id : null)" method="post">

    <input asp-for="Id" type="hidden" />
    <input asp-for="RentalApplicationId" type="hidden" />

    <div class="modal-header">
        <h5 class="modal-title">@(isEdit ? "Edit Residence" : "Add Residence")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MoveInDate" class="form-label"></label>
            <input asp-for="MoveInDate" class="form-control" />
            <span asp-validation-for="MoveInDate" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MoveOutDate" class="form-label"></label>
            <input asp-for="MoveOutDate" class="form-control" />
            <span asp-validation-for="MoveOutDate" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="LandlordName" class="form-label"></label>
            <input asp-for="LandlordName" class="form-control" />
            <span asp-validation-for="LandlordName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="LandlordPhone" class="form-label"></label>
            <input asp-for="LandlordPhone" class="form-control" />
            <span asp-validation-for="LandlordPhone" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">@(isEdit ? "Save Changes" : "Save Residence")</button>
    </div>
</form>