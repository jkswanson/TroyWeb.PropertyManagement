@model UnitViewModel

@{
    ViewData["Title"] = "Unit Details";
}

<h2>Unit Details</h2>
<dl class="row">
    <dt class="col-sm-3">Property</dt>
    <dd class="col-sm-9">@Model.PropertyName</dd>

    <dt class="col-sm-3">Unit Number</dt>
    <dd class="col-sm-9">@Model.UnitNumber</dd>

    <dt class="col-sm-3">Unit Type</dt>
    <dd class="col-sm-9">@Model.UnitTypeName</dd>

    <dt class="col-sm-3">Bedrooms</dt>
    <dd class="col-sm-9">@Model.Bedrooms</dd>

    <dt class="col-sm-3">Monthly Rent</dt>
    <dd class="col-sm-9">@Model.MonthlyRent.ToString("C")</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to Units</a>