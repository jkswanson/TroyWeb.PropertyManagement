@model IEnumerable<UnitViewModel>

@{
    ViewData["Title"] = "Units";
}

<h2>Units</h2>

<p>
    <button type="button"
            class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#unitModal"
            data-form-url="@Url.Action("Create", "Units")">
        Add Unit
    </button>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Property</th>
            <th>Unit</th>
            <th>Type</th>
            <th>Bedrooms</th>
            <th>Monthly Rent</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var unit in Model)
        {
            <tr>
                <td>@unit.PropertyName</td>
                <td>@unit.UnitNumber</td>
                <td>@unit.UnitTypeName</td>
                <td>@unit.Bedrooms</td>
                <td>@unit.MonthlyRent.ToString("C")</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@unit.Id"
                       class="btn btn-sm btn-primary">
                        Details
                    </a>

                    <button type="button"
                            class="btn btn-sm btn-secondary"
                            data-bs-toggle="modal"
                            data-bs-target="#unitModal"
                            data-form-url="@Url.Action("Edit", "Units", new { id = unit.Id })">
                        Edit
                    </button>

                    <button type="button"
                            class="btn btn-sm btn-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#unitModal"
                            data-form-url="@Url.Action("Delete", "Units", new { id = unit.Id })">
                        Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade"
     id="unitModal"
     tabindex="-1"
     aria-labelledby="unitModalLabel"
     aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="unitModalContent"></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const modalElement = document.getElementById("unitModal");
            const modalContent = document.getElementById("unitModalContent");

            modalElement.addEventListener("show.bs.modal", async (event) => {
                const trigger = event.relatedTarget;
                const url = trigger?.dataset.formUrl;

                if (!url) return;

                const response = await fetch(url);
                modalContent.innerHTML = await response.text();

                const form = modalContent.querySelector("form");

                if (form && window.jQuery?.validator?.unobtrusive) {
                    $.validator.unobtrusive.parse(form);
                }
            });

            modalContent.addEventListener("submit", async (event) => {
                const form = event.target.closest("form");
                if (!form) return;

                event.preventDefault();

                if (window.jQuery && !$(form).valid()) return;

                const response = await fetch(form.action, {
                    method: "POST",
                    body: new FormData(form)
                });

                const contentType = response.headers.get("content-type") || "";

                if (response.ok && contentType.includes("application/json")) {
                    const result = await response.json();

                    if (result.success) {
                        bootstrap.Modal.getInstance(modalElement).hide();
                        window.location.reload();
                    }

                    return;
                }

                if (response.ok && contentType.includes("text/html")) {
                    modalContent.innerHTML = await response.text();

                    const updatedForm = modalContent.querySelector("form");

                    if (updatedForm && window.jQuery?.validator?.unobtrusive) {
                        $.validator.unobtrusive.parse(updatedForm);
                    }
                }
            });
        });
    </script>
}