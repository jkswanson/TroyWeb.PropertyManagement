@model UnitFormViewModel

@{
    bool isEdit = Model.Id > 0;
    string action = isEdit ? "Edit" : "Create";
}

<div class="modal-header">
    <h5 class="modal-title">
        @(isEdit ? "Edit Unit" : "Create Unit")
    </h5>
    <button type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"></button>
</div>

<form asp-controller="Units"
      asp-action="@action"
      asp-route-id="@(isEdit ? Model.Id : (int?)null)"
      method="post">

    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="PropertyId" class="form-label"></label>
            <select asp-for="PropertyId"
                    asp-items="Model.Properties"
                    class="form-select">
                <option value="">-- Select Property --</option>
            </select>
            <span asp-validation-for="PropertyId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="UnitNumber" class="form-label"></label>
            <input asp-for="UnitNumber" class="form-control" />
            <span asp-validation-for="UnitNumber" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Bedrooms" class="form-label"></label>
            <input asp-for="Bedrooms" class="form-control" />
            <span asp-validation-for="Bedrooms" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MonthlyRent" class="form-label"></label>
            <input asp-for="MonthlyRent" class="form-control" />
            <span asp-validation-for="MonthlyRent" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="UnitTypeId" class="form-label"></label>
            <select asp-for="UnitTypeId"
                    asp-items="Model.UnitTypes"
                    class="form-select">
                <option value="">-- Select Unit Type --</option>
            </select>
            <span asp-validation-for="UnitTypeId" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            Cancel
        </button>
        <button type="submit" class="btn btn-primary">
            @(isEdit ? "Save Changes" : "Create")
        </button>
    </div>
</form>